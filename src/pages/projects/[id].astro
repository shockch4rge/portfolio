---
import RelatedProjects from "@content/components/RelatedProjects.astro";
import Tags from "@content/components/Tags.astro";
import ContentLayout from "@layouts/ContentLayout.astro";
import { getEntries, render } from "astro:content";
import { DateTime } from "luxon";
import { getProjects } from "../../content.config";

export async function getStaticPaths() {
    const projects = await getProjects();
    const tags = await getEntries(
        projects.flatMap(project => project.data.tags ?? []),
    );

    return projects.map(project => ({
        params: { id: project.id },
        props: { project, tags },
    }));
}

const { project, tags } = Astro.props;
const {
    Content,
    headings,
    remarkPluginFrontmatter: frontmatter,
} = await render(project);

const lastUpdated = DateTime.fromISO(frontmatter.lastUpdated)
    .toUTC(8)
    .toLocaleString(DateTime.DATE_FULL);
const { name, description, draft, pubDate, githubUrl, related, url } =
    project.data;
---

<>
    <ContentLayout title={name} headings={headings} tags={tags}>
        <h1>{name}</h1>
        <div class="mb-6 font-display font-medium text-gray-600">
            Published {
                DateTime.fromJSDate(pubDate)
                    .toUTC(8)
                    .toLocaleString(DateTime.DATE_FULL)
            } : updated {lastUpdated}
        </div>
        <Tags data={tags} />
        <Content />
        {related && <RelatedProjects slot="related-projects" id={project.id} />}
    </ContentLayout>
</>
