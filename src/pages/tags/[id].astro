---
import { getCollection, getEntries } from "astro:content";

import BaseLayout from "@layouts/BaseLayout.astro";
import { getBlogPosts, getProjects } from "../../content.config";
import type { BlogPost } from "../../content.config";
import type { Project } from "../../content.config";
import EntryRow from "@components/EntryRow.astro";

export async function getStaticPaths() {
    const tags = await getCollection("tags");

    return tags.map(tag => ({
        params: { id: tag.data.id },
        props: { tag },
    }));
}

const { tag } = Astro.props;
const tagId = tag.data.id;
const [allPosts, allProjects] = await Promise.all([getBlogPosts(), getProjects()]);

async function hasTag(entry: BlogPost | Project) {
    const entryTags = await getEntries(entry.data.tags ?? []);
    return entryTags.some(entryTag => entryTag.data.id === tagId);
}

const [postMatches, projectMatches] = await Promise.all([
    Promise.all(allPosts.map(async post => ((await hasTag(post)) ? post : undefined))),
    Promise.all(allProjects.map(async project => ((await hasTag(project)) ? project : undefined))),
]);

const blogPosts = postMatches.filter((post): post is BlogPost => post !== undefined);
const projects = projectMatches.filter((project): project is Project => project !== undefined);
---

<BaseLayout title={`Tag: ${tagId}`}>
    <div class="container hero auto-rows-min">
        <div class="container hero auto-rows-min">
            <h1 class="mt-36 mb-4 self-start">projects.</h1>
            <ul class="w-full flex flex-col divide-y-2 divide-gray-400/20">
                {
                    projects
                        .sort((a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime())
                        .map(project => <EntryRow baseUrl="/projects" entry={project} />)
                }
            </ul>
            <h1 class="mt-36 mb-4 self-start">blog.</h1>
            <ul class="w-full flex flex-col divide-y-2 divide-gray-400/20">
                {
                    blogPosts
                        .sort((a, b) => a.data.pubDate.getTime() - b.data.pubDate.getTime())
                        .map(post => <EntryRow baseUrl="/blog" entry={post} />)
                }
            </ul>
        </div>
    </div>
</BaseLayout>
