---
import { getCollection, getEntries } from "astro:content";

import BlogCard from "@components/BlogCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getBlogPosts, getProjects } from "../../content.config";
import type { BlogPost } from "../../content.config";
import type { Project } from "../../content.config";

export async function getStaticPaths() {
    const tags = await getCollection("tags");

    return tags.map(tag => ({
        params: { id: tag.data.id },
        props: { tag },
    }));
}

const { tag } = Astro.props;
const tagId = tag.data.id;
const [allPosts, allProjects] = await Promise.all([
    getBlogPosts(),
    getProjects(),
]);

async function hasTag(entry: BlogPost | Project) {
    const entryTags = await getEntries(entry.data.tags ?? []);
    return entryTags.some(entryTag => entryTag.data.id === tagId);
}

const [postMatches, projectMatches] = await Promise.all([
    Promise.all(
        allPosts.map(async post => ((await hasTag(post)) ? post : undefined)),
    ),
    Promise.all(
        allProjects.map(async project =>
            (await hasTag(project)) ? project : undefined,
        ),
    ),
]);

const posts = postMatches.filter(
    (post): post is BlogPost => post !== undefined,
);
const projects = projectMatches.filter(
    (project): project is Project => project !== undefined,
);
---

<BaseLayout title={`Tag: ${tagId}`}>
    <div class="container hero auto-rows-min">
        <h1 class="mt-36 mb-24 self-start h-fit">#{tagId}</h1>
        {
            projects.length > 0 && (
                <section class="w-full mb-24">
                    <h2 class="mb-16 text-3xl">projects.</h2>
                    <ul class="w-full px-1 py-2 grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3 gap-10 lg:gap-10">
                        {projects.map(({ data, id }, index) => (
                            <ProjectCard
                                index={index}
                                project={{ ...data, id }}
                            />
                        ))}
                    </ul>
                </section>
            )
        }
        {
            posts.length > 0 && (
                <section class="w-full mb-24">
                    <h2 class="mb-16 text-3xl">blog.</h2>
                    <ul class="w-full px-1 py-2 grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3 gap-10 lg:gap-10">
                        {posts.map(({ data, id }, index) => (
                            <BlogCard index={index} post={{ ...data, id }} />
                        ))}
                    </ul>
                </section>
            )
        }
        {
            projects.length === 0 && posts.length === 0 && (
                <p class="w-full text-xl">
                    No published pages use this tag yet.
                </p>
            )
        }
    </div>
</BaseLayout>
